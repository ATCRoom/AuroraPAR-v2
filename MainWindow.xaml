<Window x:Class="AuroraPAR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aurora PAR" Height="600" Width="800" Icon="AuroraPAR.ico"
        MouseWheel="Window_MouseWheel">
    <Window.Resources>
        <!-- Analog mode: controls styled as the parts of an old equipment (applied from the code, see ApplyDisplayMode). -->
        <Style x:Key="ConsoleButton" TargetType="Button">
            <Setter Property="FontFamily" Value="./Fonts/#Barlow Condensed"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="#D8D8D0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" SnapsToDevicePixels="True">
                            <Border CornerRadius="4" Background="#0E0F0D"/>
                            <Border x:Name="Cap" CornerRadius="4" BorderBrush="#0E0F0D" BorderThickness="1" Margin="0,0,0,3">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#5A5C56" Offset="0"/>
                                        <GradientStop Color="#3A3C36" Offset="0.08"/>
                                        <GradientStop Color="#2C2D29" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Border x:Name="Hover" CornerRadius="3" Background="White" Opacity="0" IsHitTestVisible="False"/>
                                    <ContentPresenter x:Name="Label" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- Lit: the whole key is backlit (warm white), the engraving turns dark. -->
                            <Trigger Property="Tag" Value="Lit">
                                <Setter Property="Foreground" Value="#33270A"/>
                                <Setter TargetName="Cap" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FFC85A" ShadowDepth="0" BlurRadius="12" Opacity="0.6"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Cap" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FFF7DE" Offset="0"/>
                                            <GradientStop Color="#FFE8B0" Offset="0.6"/>
                                            <GradientStop Color="#FFD983" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.1"/>
                            </Trigger>
                            <!-- Spring-loaded: the cap goes down while held and darker. -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Cap" Property="Margin" Value="0,3,0,0"/>
                                <Setter TargetName="Hover" Property="Background" Value="Black"/>
                                <Setter TargetName="Hover" Property="Opacity" Value="0.25"/>
                            </Trigger>
                            <!-- Latching (selection keys): the selected one stays pressed in, and lit. -->
                            <Trigger Property="Tag" Value="Selected">
                                <Setter Property="Foreground" Value="#33270A"/>
                                <Setter TargetName="Cap" Property="Margin" Value="0,3,0,0"/>
                                <Setter TargetName="Cap" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FFC85A" ShadowDepth="0" BlurRadius="10" Opacity="0.5"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Cap" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#E8C878" Offset="0"/>
                                            <GradientStop Color="#FFE8B0" Offset="0.25"/>
                                            <GradientStop Color="#FFD983" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Analog: range keys as on the FIAR console (one key per range): a lens backlit all the time, dim; the range in
             use (Tag "Selected") bright warm white. -->
        <Style x:Key="PanelKey" TargetType="Button">
            <Setter Property="FontFamily" Value="./Fonts/#Barlow Condensed"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#2A2622"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" SnapsToDevicePixels="True">
                            <Border CornerRadius="3" Background="#0B0B0A" BorderBrush="#333331" BorderThickness="1"/>
                            <Border x:Name="Lens" CornerRadius="2" Margin="3">
                                <Border.Background>
                                    <RadialGradientBrush Center="0.5,0.45" GradientOrigin="0.5,0.45" RadiusX="0.7" RadiusY="0.7">
                                        <GradientStop Color="#8A847B" Offset="0"/>
                                        <GradientStop Color="#6F6A63" Offset="0.6"/>
                                        <GradientStop Color="#5A5550" Offset="1"/>
                                    </RadialGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Border x:Name="Hover" CornerRadius="2" Background="White" Opacity="0" IsHitTestVisible="False"/>
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="False"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.08"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Lens" Property="Margin" Value="4,5,2,1"/>
                                <Setter TargetName="Hover" Property="Background" Value="Black"/>
                                <Setter TargetName="Hover" Property="Opacity" Value="0.2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.5"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Lit">
                                <Setter Property="Foreground" Value="#1D1A17"/>
                                <Setter TargetName="Lens" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FFF6E1" ShadowDepth="0" BlurRadius="12" Opacity="0.6"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Lens" Property="Background">
                                    <Setter.Value>
                                        <RadialGradientBrush Center="0.5,0.45" GradientOrigin="0.5,0.45" RadiusX="0.7" RadiusY="0.7">
                                            <GradientStop Color="#FFFDF6" Offset="0"/>
                                            <GradientStop Color="#F3ECE0" Offset="0.55"/>
                                            <GradientStop Color="#D9CFC0" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter Property="Foreground" Value="#1D1A17"/>
                                <Setter TargetName="Lens" Property="Margin" Value="4,4,2,2"/>
                                <Setter TargetName="Lens" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FFF6E1" ShadowDepth="0" BlurRadius="12" Opacity="0.6"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Lens" Property="Background">
                                    <Setter.Value>
                                        <RadialGradientBrush Center="0.5,0.45" GradientOrigin="0.5,0.45" RadiusX="0.7" RadiusY="0.7">
                                            <GradientStop Color="#FFFDF6" Offset="0"/>
                                            <GradientStop Color="#F3ECE0" Offset="0.55"/>
                                            <GradientStop Color="#D9CFC0" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Modern display: flat keys of a PC program (runway and glide path keys); Tag "Lit" = the one in use. -->
        <Style x:Key="ModernKey" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#202020"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" CornerRadius="3" Background="#EDEDED" BorderBrush="#C4C4C4" BorderThickness="1" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#E0EAF6"/>
                                <Setter TargetName="Face" Property="BorderBrush" Value="#7FA7D6"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Lit">
                                <Setter TargetName="Face" Property="Background" Value="#0078D4"/>
                                <Setter TargetName="Face" Property="BorderBrush" Value="#005A9E"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="Face" Property="Background" Value="#0067B8"/>
                                <Setter TargetName="Face" Property="BorderBrush" Value="#004A80"/>
                                <Setter TargetName="Face" Property="BorderThickness" Value="1,2,1,0"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#B8CDE6"/>
                                <Setter TargetName="Face" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Small engraved title above a group of keys. -->
        <Style x:Key="EngravedLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="./Fonts/#B612"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="#D8D8D0"/>
            <Setter Property="Margin" Value="2,0,0,3"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="100"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Name="DisplayArea">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Analog mode: console panel with the digital readouts and status lamps. -->
            <!-- Scaled with the window: smaller in a small window, never wider than about a quarter of the display. -->
            <Border Grid.Column="0" Name="ConsoleHost" Visibility="Collapsed" Background="#2E302C" BorderBrush="#1A1B18" BorderThickness="0,0,1,0">
                <Viewbox Name="ConsoleViewbox" Stretch="Uniform" VerticalAlignment="Top"/>
            </Border>
            <Grid Grid.Column="1" Name="ScopeHost">
            <Grid Name="ScopeArea">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Canvas Name="Vertical" Grid.Row="0" Background="Black"/>
                <Canvas Name="Horizontal" Grid.Row="1" Background="Black"/>
            </Grid>
            <!-- Analog mode: frame of the round scope. -->
            <Canvas Name="BezelLayer" IsHitTestVisible="False" ClipToBounds="True"/>
            </Grid>
        </Grid>
        <Border Grid.Column="1" Name="ControlPanel">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Selectors "on the fly". Shrinks (never grows) when the window is too low for all the controls. -->
            <Viewbox Grid.Row="0" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top">
            <StackPanel Name="SelectorStack" Width="100">
                <!-- Analog mode: airport entry (readout window) and push keys with a lamp for runway and glide path. -->
                <StackPanel Name="AptPanel" Visibility="Collapsed" Margin="0,0,0,10">
                    <TextBlock Text="APT" Style="{StaticResource EngravedLabel}"/>
                    <Border Name="AptHost" HorizontalAlignment="Center"/>
                </StackPanel>
                <DockPanel Name="IcaoPanel" Height="26" Margin="0,0,0,8"
                           ToolTip="Airport in use: type its ICAO; with the fourth letter (or Enter, when the letters typed fit a single airport) its runways appear as keys below. Red: no airport in runways.par starts with these letters. Esc or leaving the box: back to the airport in use.&#x0a;The airport of the callsign connected in Aurora (e.g. LIPC_APP gives LIPC) is set here when you connect.">
                    <TextBlock Name="IcaoLabel" Text="ICAO" VerticalAlignment="Center" Margin="2,0,6,0"/>
                    <TextBox Name="IcaoFilterBox" CharacterCasing="Upper" MaxLength="4" VerticalContentAlignment="Center"/>
                </DockPanel>
                <!-- Runway keys of the airport in use (both modes; none when it has a single runway). -->
                <StackPanel Name="RunwayButtonPanel" Visibility="Collapsed" Margin="0,0,0,8">
                    <TextBlock Name="RunwayKeysLabel" Text="RWY" Style="{StaticResource EngravedLabel}"/>
                    <Border Name="RunwayPlate" Background="#1F201D" BorderBrush="#0E0F0D" BorderThickness="1" CornerRadius="5" Padding="0,2,0,0"><UniformGrid Name="RunwayButtons" Columns="2"/></Border>
                </StackPanel>
                <!-- Internal list of the runways (selection), never shown: the keys and the ICAO box replace it. -->
                <ComboBox Name="RunwayComboBox" Height="30" Visibility="Collapsed"/>
                <ComboBox Name="DistanceComboBox" Height="30"/>
                <!-- Modern: back to the preferred range (key End); the text is chosen in Settings. -->
                <Button Name="PrefButton" Content="PREF" Height="24" Margin="0,4,0,0" Style="{StaticResource ModernKey}"
                        ToolTip="Back to the preferred range (Settings → Range and scale). Key End."/>
                <!-- Distance scale: linear or log (compressed), key C. -->
                <UniformGrid Name="ScalePanel" Columns="2" Height="24" Margin="0,4,0,0"
                             ToolTip="Distance scale: linear, or log (the last miles larger, the far ones closer; how much: Settings → Range and scale). Key C.">
                    <Button Name="LinButton" Content="LIN" Style="{StaticResource ModernKey}" Margin="0,0,1,0"/>
                    <Button Name="LogButton" Content="LOG" Style="{StaticResource ModernKey}" Margin="1,0,0,0"/>
                </UniformGrid>
                <!-- Glide path keys of the published approaches (none with one). Modern: moved into GlidePathPanel, above the free angle box. -->
                <StackPanel Name="GlideButtonPanel" Visibility="Collapsed" Margin="0,0,0,8">
                    <TextBlock Name="GlideKeysLabel" Text="GP DEG" Style="{StaticResource EngravedLabel}"/>
                    <Border Name="GlidePlate" Background="#1F201D" BorderBrush="#0E0F0D" BorderThickness="1" CornerRadius="5" Padding="0,2,0,0"><UniformGrid Name="GlideButtons" Columns="2"/></Border>
                </StackPanel>
                <StackPanel Name="GlidePathPanel" Margin="0,10,0,0">
                    <TextBlock Name="GlidePathLabel" Text="GP (°)" Margin="2,0,0,2"/>
                    <!-- Angle in use; another angle typed here (Enter) is an unpublished approach. The published ones are the keys above. -->
                    <TextBox Name="GlidePathTextBox" Height="26" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Name="DhPanel" Margin="0,10,0,0"
                            ToolTip="Decision height for this session only: not saved, reset when the runway changes.">
                    <TextBlock Name="DhLabel" Text="DH (ft)" Margin="2,0,0,2"/>
                    <DockPanel Height="26">
                        <Button Name="DhDownButton" Content="−" Width="26" DockPanel.Dock="Left"/>
                        <Button Name="DhUpButton" Content="+" Width="26" DockPanel.Dock="Right"/>
                        <TextBox Name="DhTextBox" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
                <StackPanel Name="CoursePanel" Margin="0,10,0,0" Visibility="Collapsed"
                            ToolTip="Final course for this session only (e.g. a ship): − / + one degree, or type the course and press Enter. Not saved, back to the runway value when the runway changes (Alt+Home). Keys Alt+← / Alt+→.">
                    <TextBlock Name="CourseLabel" Text="CRS (°)" Margin="2,0,0,2"/>
                    <DockPanel Height="26">
                        <Button Name="CourseDownButton" Content="−" Width="26" DockPanel.Dock="Left"/>
                        <Button Name="CourseUpButton" Content="+" Width="26" DockPanel.Dock="Right"/>
                        <TextBox Name="CourseTextBox" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
                <StackPanel Name="BrightnessPanel" Margin="0,10,0,0"
                            ToolTip="Brightness of the radar picture, 10% to 150% (above 100% the colours are boosted, for dim monitors). Also with the mouse wheel over it.">
                    <TextBlock Text="BRT" Margin="2,0,0,2"/>
                    <DockPanel Height="26">
                        <Button Name="BrightnessDownButton" Content="−" Width="26" DockPanel.Dock="Left"/>
                        <Button Name="BrightnessUpButton" Content="+" Width="26" DockPanel.Dock="Right"/>
                        <TextBlock Name="BrightnessText" Text="100%" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
                <StackPanel Name="TiltPanel" Margin="0,12,0,0"
                            ToolTip="Antenna tilt. Keyboard: arrows to tilt (up/down elevation, left/right azimuth), Home for neutral.">
                    <TextBlock Text="Antenna tilt" Margin="2,0,0,2"/>
                    <UniformGrid Columns="2" Height="26">
                        <Button Name="TiltUpButton" Content="EL ▲" Margin="0,0,1,0"/>
                        <Button Name="TiltDownButton" Content="EL ▼" Margin="1,0,0,0"/>
                    </UniformGrid>
                    <UniformGrid Columns="2" Height="26" Margin="0,2,0,0">
                        <Button Name="TiltLeftButton" Content="AZ ◀" Margin="0,0,1,0" ToolTip="Azimuth tilt left (key ←; Settings → Radar: as seen by the pilot, or from the runway)"/>
                        <Button Name="TiltRightButton" Content="AZ ▶" Margin="1,0,0,0" ToolTip="Azimuth tilt right (key →; Settings → Radar: as seen by the pilot, or from the runway)"/>
                    </UniformGrid>
                    <Button Name="TiltNeutralButton" Content="Neutral" Height="26" Margin="0,2,0,0"/>
                </StackPanel>
                <!-- Analog mode: knobs instead of the range box, tilt buttons and DH buttons. -->
                <StackPanel Name="KnobPanel" Margin="0,8,0,0" Visibility="Collapsed"/>
                <Button Name="LabelsButton" Content="Hide labels (L)" Margin="0,16,0,0" Height="26"
                        ToolTip="Show or hide the labels of all tracks (key L). Showing them again also brings back the labels hidden one by one. Right click on a label (or near its track) hides only that one; right click near the track shows it again."/>
            </StackPanel>
            </Viewbox>
            <!-- System buttons, fixed at the bottom edge, apart from the selectors. -->
            <StackPanel Grid.Row="1" Width="100" VerticalAlignment="Bottom" Margin="0,6,0,4">
                <Border Height="1" Background="#55808080" Margin="0,0,0,6"/>
                <!-- Modern: one button per row. Analog: square keys, two per row, on a recessed plate (see ApplyControlStyles). -->
                <Border Name="SystemPlate" CornerRadius="5" BorderThickness="1">
                <WrapPanel Width="98">
                    <Button Name="ModeButton" Content="Analog (A)" Margin="0,4,0,0" Height="26" Width="98"
                            ToolTip="Switch between the modern display and the analog scope (key A)."/>
                    <Button Name="CoordinationButton" Content="Coordination" Margin="0,4,0,0" Height="26" Width="98"
                            ToolTip="Coordination light panel with the tower (voiceless coordination)."/>
 <Button Name="TestButton" Content="Test (T)" Margin="0,4,0,0" Height="26" Width="98"
                            ToolTip="Test: one aircraft on final at 10 NM, to see the tracks and labels of a profile (key T; again: removed)."/>
                    <Button Name="BasicButton" Content="Instructor (I)" Margin="0,4,0,0" Height="26" Width="98"
                            ToolTip="Instructor (basic): a small window to fly aircraft for practice or a lesson at the same PC (key I)."/>
                    <Button Name="InstructorButton" Content="Advanced (⇧I)" Margin="0,4,0,0" Height="26" Width="98" Visibility="Collapsed"
                            ToolTip="Instructor (advanced, preview): the full instructor station (Shift+I). Turned on in the Settings."/>
                    <Border Name="SystemSeparator" Height="1" Width="98" Background="#55808080" Margin="0,8,0,4"/>
                    <Button Name="SettingsButton" Content="Settings..." Margin="0,4,0,0" Height="30" Width="98"/>
                    <!-- Help: the user manual (online) and the list of keys (also F1). -->
                    <Button Name="ManualButton" Content="Manual" Margin="0,4,0,0" Height="24" Width="48"
                            ToolTip="Open the user manual (in the browser)."/>
                    <Button Name="KeysButton" Content="Keys" Margin="2,4,0,0" Height="24" Width="48"
                            ToolTip="List of the keyboard and mouse shortcuts (F1)."/>
                    <!-- Spare key, no longer used (the analog console has six keys: mode, coordination, test, setup, manual, keys). -->
                    <Button Name="SpareKey" Visibility="Collapsed" IsTabStop="False"/>
                </WrapPanel>
                </Border>
            </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>