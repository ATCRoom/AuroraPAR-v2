<UserControl x:Class="AuroraPAR.DisplayStylePanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The three parts are taken by the Settings window (sections Range and scale, Colours and lines, Reminders). -->
    <StackPanel>
        <TabControl Name="Tabs">
            <TabItem Header="Range marks">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" MaxWidth="600" Foreground="Gray" Tag="Advanced"
                               Text="Marks at each range: each ticked box draws those lines with their own style (Colours and lines). Where ticked boxes overlap (e.g. 1 NM is also a ½ and a ¼ mile), the largest one wins. Changes are applied immediately."/>
                    <Border Background="#F6F6F6" BorderBrush="#CCCCCC" BorderThickness="1" Padding="8,6" Margin="0,10,0,0" HorizontalAlignment="Left" Tag="Advanced">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Distance text on all ranges:" VerticalAlignment="Center"/>
                            <ComboBox Name="AllTextCombo" Width="140" Height="24" Margin="8,0,0,0" SelectedIndex="0">
                                <ComboBoxItem Content="Full (1.25NM)"/>
                                <ComboBoxItem Content="Number only (1.25)"/>
                                <ComboBoxItem Content="None"/>
                            </ComboBox>
                            <Button Name="AllTextButton" Content="Apply to all" Height="26" Padding="14,0" Margin="8,0,0,0"
                                    ToolTip="Full / Number only: unit on or off on every range (a range without text gets the default marks again). None: no text on any range. Single ranges can be changed afterwards."/>
                        </StackPanel>
                    </Border>
                    <Grid Name="RangeMarkGrid" Margin="0,10,0,0" Tag="Advanced"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="Distance text:" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <RadioButton Name="DecimalRadio" GroupName="DistanceText" Content="Decimal (1.25NM)" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <RadioButton Name="FractionsRadio" GroupName="DistanceText" Content="Fractions (1 1/4NM)" Margin="0,0,24,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Text size:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Name="TextSizeComboBox" Width="70" Height="22" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="Range marks:" VerticalAlignment="Center" Margin="0,0,8,0"
                                   ToolTip="Lines across the view (default), only short ticks on the distance axis (horizon line, centreline) as on some real scopes, or both."/>
                        <ComboBox Name="DrawingComboBox" Width="90" Height="22" VerticalAlignment="Center"/>
                        <TextBlock Text="Tick length:" VerticalAlignment="Center" Margin="16,0,8,0"/>
                        <ComboBox Name="TickLengthComboBox" Width="70" Height="22" VerticalAlignment="Center"/>
                        <TextBlock Text="Side:" VerticalAlignment="Center" Margin="16,0,8,0"/>
                        <ComboBox Name="TickSideComboBox" Width="80" Height="22" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Name="RangeMarksDefaultButton" Content="Default" HorizontalAlignment="Left" Width="80" Height="26" Margin="0,10,0,0" Tag="Advanced"
                            ToolTip="Default marks per range (the text format, size and the lines / ticks choice stay)."/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Colours &amp; lines">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" MaxWidth="700" Foreground="Gray"
                               Text="Colour (modern display), line style and width (both displays) of each element. Plots are the history dots, tracks the aircraft symbols. Modern / Analog (last two columns): draw the line or not, separately in the modern display and on the analog scope (e.g. no approach limit lines, as on many old scopes; the track colour still follows the limits). Changes are applied immediately."/>
                    <Grid Name="StyleGrid" Margin="0,10,0,0"/>
                    <Button Name="StyleDefaultButton" Content="Default" HorizontalAlignment="Left" Width="80" Height="26" Margin="0,10,0,0"/>
                    <GroupBox Header="Analog scope" Padding="8" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" MaxWidth="580" Foreground="Gray"
                                       Text="The analog scope uses one colour, its phosphor, with a different brightness for each element; the line style and width set above apply to it too."/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Phosphor:" VerticalAlignment="Center"/>
                                <ComboBox Name="PhosphorComboBox" Width="190" Margin="8,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                        ToolTip="On real scopes the beam widens with the distance, so a far aircraft gives a longer echo. 1× = always the same length (the size of the Track symbol).">
                                <TextBlock Text="Echo length at the far end:" VerticalAlignment="Center"/>
                                <Slider Name="EchoGrowthSlider" Width="150" Minimum="1" Maximum="4" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Name="EchoGrowthText" Width="90" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>
            <TabItem Header="Reminders">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" MaxWidth="760" Foreground="Gray"
                               Text="Distance reminders for all runways: a marker above the distance in the elevation view, a coloured line across both views (it replaces the range mark at that distance), or both. Each runway can also have its own reminders, in Runways... . Changes are applied immediately."/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Horizon line:" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <RadioButton Name="MarkersAboveRadio" GroupName="MarkerPosition" Content="distance text above, markers below" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <RadioButton Name="MarkersBelowRadio" GroupName="MarkerPosition" Content="distance text below, markers above" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ContentControl Name="RemindersHost" Margin="0,10,0,0" Focusable="False"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </StackPanel>
</UserControl>
