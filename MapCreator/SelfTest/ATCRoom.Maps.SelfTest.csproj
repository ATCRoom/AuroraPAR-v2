<Project Sdk="Microsoft.NET.Sdk">

  <!-- Self-test of the map format and of the importers, run by the GitHub build at every push (dotnet run): each check
       prints OK or FAIL, and any failure ends the program with exit code 1, which makes the build fail. The samples
       are small invented files, written here. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ATCRoom.Maps.SelfTest</RootNamespace>
    <AssemblyName>ATCRoom.Maps.SelfTest</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\ATCRoom.Maps.csproj" />
  </ItemGroup>

</Project>
