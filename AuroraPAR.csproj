<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>AuroraPAR.ico</ApplicationIcon>
    <!-- Version of the program, shown in the title bar and in the Keys window. Raise it at every release (2.0.0 for the final one). -->
    <Version>2.0.1</Version>
  </PropertyGroup>

  <!-- Date and commit of the build (the commit is given by the GitHub build: -p:BuildCommit=...), read by AppInfo. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildTime</_Parameter1>
      <_Parameter2>$([System.DateTime]::UtcNow.ToString("yyyy-MM-ddTHH:mm:ssZ"))</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>Commit</_Parameter1>
      <_Parameter2>$(BuildCommit)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="AuroraPAR.ico" />
    <!-- B612, the font of the Airbus cockpit displays (SIL Open Font License, see Fonts/B612-OFL.txt). -->
    <Resource Include="Fonts\B612-Bold.ttf" />
    <Resource Include="Fonts\B612-Regular.ttf" />
    <!-- Barlow Condensed Bold, narrow lettering of the analog console keys (SIL Open Font License, see Fonts/BarlowCondensed-OFL.txt). -->
    <Resource Include="Fonts\BarlowCondensed-Bold.ttf" />
    <!-- Carlito Bold, the digits and letters of the drum counters of the analog console (SIL Open Font License, see Fonts/Carlito-OFL.txt). -->
    <Resource Include="Fonts\Carlito-Bold.ttf" />
    <!-- Sound of the coordination panel: the buzzer of the real light panel, recorded in a PAR room. -->
    <Resource Include="Sounds\coord-beep.wav" />
  </ItemGroup>

  <!-- The standalone coordination panel (Coord folder) is a separate program. -->
  <ItemGroup>
    <Compile Remove="Coord\**" />
    <None Remove="Coord\**" />
    <Page Remove="Coord\**" />
    <Compile Remove="CRSCalculator\**" />
    <None Remove="CRSCalculator\**" />
    <Page Remove="CRSCalculator\**" />
    <Resource Remove="CRSCalculator\**" />
    <!-- The simulation engine of the Instructor and its self-test are separate projects (Sim folder). -->
    <Compile Remove="Sim\**" />
    <None Remove="Sim\**" />
    <Page Remove="Sim\**" />
    <Resource Remove="Sim\**" />
    <!-- AuroraPAR v2 Trainer is a separate program (Trainer folder): it builds these same files plus its own parts. -->
    <Compile Remove="Trainer\**" />
    <None Remove="Trainer\**" />
    <Page Remove="Trainer\**" />
    <Resource Remove="Trainer\**" />
    <!-- ATCRoom Map Creator and the map format library are separate projects (MapCreator folder). -->
    <Compile Remove="MapCreator\**" />
    <None Remove="MapCreator\**" />
    <Page Remove="MapCreator\**" />
    <Resource Remove="MapCreator\**" />
  </ItemGroup>

  <!-- The simulation engine (ATCRoom Sim, no WPF): built into AuroraPAR.exe, one download as before. -->
  <ItemGroup>
    <ProjectReference Include="Sim\Engine\ATCRoom.Sim.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- MQTT client for the coordination light panel (MIT license). -->
    <PackageReference Include="MQTTnet" Version="4.3.7.1207" />
    <!-- QR code of the phone panel link (MIT license). -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="runways.par">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="terrain.par">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Profiles that come with the program: the profiles of a first start (no settings file yet). -->
    <None Include="Profiles\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
